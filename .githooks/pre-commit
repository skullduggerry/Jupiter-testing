#!/usr/bin/env bash
# Formats the staged files of the repo being committed to and stages them
# again, then lints them and runs the suites. scripts/install-hooks.sh
# points every Jupiter clone's hooks here.
hooks=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
exec "$hooks/../check.sh" check "$(git rev-parse --show-toplevel)" --fix --staged
